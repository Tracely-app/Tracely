# Copy this file to .env before running `npm run dev` or `npm run dist:win`.
# TRACELY_API_URL and the two SUPABASE_ values at the bottom are baked into
# the app at BUILD time (see the `define` block in electron.vite.config.ts) —
# there is no in-app Settings field for them, and no runtime way for a user to
# see or change them. Only whoever builds the app controls this.

# The Tracely server the app's AI calls go to. Optional: leave it blank (or
# delete the line) and the build uses https://api.jointracely.com, the hosted
# server. Set it to point a build at a server you run yourself, e.g.
# http://localhost:4477 for `cd server && npm start`.
TRACELY_API_URL=

# Optional. Unlike the values baked in at build time, these are read at
# RUNTIME (config.json in the app data dir, falling back to this file). Neither
# is a cost or security concern — both are free and rate-limit-scoped rather
# than billed.

# Semantic Scholar's keyless tier is one pool shared across every anonymous
# caller worldwide, so it answers 429 most of the time. A key gives a
# dedicated 1 req/sec. Apply at semanticscholar.org/product/api#api-key-form.
SEMANTIC_SCHOLAR_API_KEY=

# NCBI/PubMed meters by IP without a key — shared with everyone behind the
# same school or library gateway. A key meters against the key instead and
# raises the ceiling from ~3 to ~10 req/sec. Free and instant from an NCBI
# account: Account Settings > API Key Management.
NCBI_API_KEY=

# Supabase project for real user accounts (Settings > Data API in the
# Supabase dashboard). The anon key is safe to bake in — it is not secret,
# access control is enforced by Row-Level Security policies in Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
