# No trailing slash, on purpose. `node_modules/` matches only a DIRECTORY, so
# a node_modules SYMLINK — which is how a git worktree borrows the main
# checkout's dependencies — slipped past it and was committed in #248, as a
# link to one machine's absolute path. On a checkout without that path it is a
# dangling link, and on Windows it collides with the real folder.
node_modules
out/
release/
release-preview/
# Glob, not a list. The old form named .env, .env.backup* and .env.release
# individually, so .env.staging — added when staging became a real
# environment — would have been committed on the next `git add -A`.
.env
.env.*
!.env.example
*.db
*.db-journal
*.db-wal
*.db-shm
.DS_Store
HANDOFF.md
*.tsbuildinfo

# electron-vite writes a timestamped copy of the config next to it while
# bundling, and does not always clean it up. The autocommit hook runs
# `git add -A`, so one of these was committed the first time it appeared.
electron.vite.config.*.mjs
electron.vite.config.*.js

# electron-builder drops this in the repo root when a local build fails. Same
# story as above: the autocommit hook's `git add -A` swept one into a feature
# branch and it rode a merge into main.
builder-error.log

# Model weights that ship in the installer. Binary, 22MB, and reproducible
# exactly from a pinned model id — scripts/fetch-models.mjs rebuilds them, and
# the dist/release scripts run it before electron-builder.
resources/models/

# Claude Code. The directory itself is tracked on purpose — settings.json,
# hooks/ and commands/ are project configuration and every contributor should
# get the same ones. Only per-machine state is ignored.
#
# .claude/worktrees/ matters most: subagents launched with worktree isolation
# create throwaway checkouts there, and without this line each one becomes a
# candidate for `git add -A`.
.claude/settings.local.json
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/routines/.state/
.claude/scheduled_tasks.*
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/first-run
.claude/assistant-daemon-state.json

# Playwright/e2e run artifacts — a local record of the last run, not source.
test-results/

# local Anthropic backend (server/) — secrets and per-user data never commit
server/.env
server/data/
server/node_modules/
# browser builds of the renderer
dist-web/
dist-demo/
demo.html

# Tracely live preview (dev-only, generated/gitignored)
extension-dev/
.env.live

# The test extension's token. server/scripts/pack-extension.sh --beta writes
# beta.json into its STAGED copy only; one sitting in extension/ is a mistake
# waiting for `git add -A`, and this repo is public.
extension/beta.json

# The fix-in-doc browser drivers write screenshots and throwaway Chrome
# profiles next to themselves (out/ is already ignored above).
extension/dev/fix-in-doc/shots/
extension/dev/fix-in-doc/profile-*
