{
  "name": "tracely",
  "version": "0.3.98",
  "description": "Tracely — a private, local AI writing and research assistant that strengthens the credibility of what you write.",
  "main": "./out/main/index.js",
  "author": "Tracely",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "preview:ui": "node scripts/preview-ui.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "start": "electron-vite preview",
    "dist:win": "npm run strip-foreign-natives && npm run fetch-models && electron-vite build && electron-builder --win",
    "dist:mac": "npm run fetch-models && electron-vite build && electron-builder --mac",
    "release:win": "npm run preflight && npm run strip-foreign-natives && npm run fetch-models && electron-vite build && electron-builder --win --publish never && npm run publish:dl",
    "preview:win": "npm run strip-foreign-natives && npm run fetch-models && electron-vite build && electron-builder --win --publish never -c.appId=com.tracely.app.preview -c.productName=\"Tracely Preview\" -c.extraMetadata.name=tracely-preview -c.publish.channel=preview -c.directories.output=release-preview && npm run publish:dl:preview",
    "preflight": "node scripts/preflight.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "verify-packaged-ml": "node scripts/verify-packaged-ml.mjs",
    "ship": "node scripts/ship.mjs",
    "ship:preview": "node scripts/ship-preview.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "evaluate:smoke": "node scripts/evaluate.mjs --smoke",
    "eval:citations": "node eval/citations/run.mjs",
    "eval:rank": "node eval/retrieval/rank.mjs",
    "eval:floor": "node eval/retrieval/floor.mjs",
    "eval:robustness": "node eval/retrieval/robustness.mjs",
    "eval:stance": "node eval/retrieval/stance.mjs",
    "eval:critique": "node eval/critique/score.mjs",
    "eval:fabrication": "node eval/fabrication/run.mjs",
    "eval:validate": "node eval/scripts/validate-annotations.mjs",
    "eval:import-baseline": "node eval/scripts/import-baseline.mjs",
    "eval:fit": "node eval/scripts/fit-weights.mjs",
    "preview": "node scripts/preview.mjs",
    "check:eval-bundle": "node scripts/check-eval-bundle.mjs",
    "test:e2e": "electron-vite build --config e2e/electron.vite.e2e.config.mts && node --test \"e2e/**/*.spec.mjs\"",
    "ship:dry": "node scripts/ship.mjs --dry-run",
    "live": "node scripts/live.mjs",
    "strip-foreign-natives": "node scripts/strip-foreign-natives.mjs",
    "publish:dl": "node scripts/publish-dl.mjs",
    "publish:dl:preview": "node scripts/publish-dl.mjs --dir release-preview --channel preview"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.112.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.30.0",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
